@page "/"
@using Microsoft.AspNetCore.Components.Web
@using CalendarRemediation.Host.Review.Views

<PageTitle>Calendar Remediation · Demo workspace</PageTitle>
<div class="app-shell" data-workspace="calendar-remediation">
    <aside class="sidebar" aria-label="Workspace navigation">
        <a class="wordmark" href="/"><span class="brand-icon" aria-hidden="true">cr</span><span>calendar<small>remediation</small></span></a>
        <p class="workspace-label">YOUR WORKSPACE</p>
        <nav>
            @foreach (var item in Navigation)
            {
                <button class="nav-item @(view == item.Key ? "active" : "")" aria-current="@(view == item.Key ? "page" : null)" @onclick="() => Navigate(item.Key)">
                    <span aria-hidden="true">@item.Icon</span>@item.Label
                    @if (item.Key == "meetings")
                    {
                        <small>@meetings.Count</small>
                    }
                </button>
            }
        </nav>
        <div class="sidebar-bottom">
            <div class="sidebar-tip">
                <span aria-hidden="true">✧</span>
                <strong>Your intent. Your decision.</strong>
                <p>Understand the difference before making a change.</p>
            </div>
            <button class="nav-item" @onclick='() => Navigate("help")'><span aria-hidden="true">?</span>Help &amp; demo guide</button>
            <div class="profile">
                <span class="avatar">JD</span>
                <div><strong>Jamie Davis</strong><small>Sample organizer</small></div>
                <span class="demo-small">DEMO</span>
            </div>
        </div>
    </aside>
    <div class="main-shell">
        <header class="topbar">
            <div><span>Workspace</span><span class="crumb-divider">/</span><strong>@ViewTitle</strong></div>
            <span class="session-pill">● Demo session</span>
        </header>
        <main id="main-content" class="content" tabindex="-1" @ref="mainContent">
            <div class="demo-banner">
                <span class="banner-icon" aria-hidden="true">i</span>
                <p><strong>A safe space to explore.</strong> Meetings, AI suggestions, time rules, and results are illustrative. No calendar is connected or changed.</p>
                <button class="text-button" @onclick='() => Navigate("help")'>About this demo ↗</button>
            </div>
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="feedback" role="status">@message</div>
            }
            @if (view == "meetings")
            {
                <MeetingWorkspaceView Meetings="meetings" FilteredMeetings="FilteredMeetings.ToArray()" Location="location"
                                      Filters="Filters" ActiveFilter="@activeFilter" Search="@search"
                                      OnFilter="SetFilter" OnSearch="@(value => search = value)" OnClearFilters="ClearFilters"
                                      OnOpenMeeting="OpenMeeting" OnPreview="OpenPreview" OnLocations='@(() => Navigate("locations"))' />
            }
            else if (view == "locations")
            {
                <LocationsView Locations="Locations" Location="location" OnChooseLocation="ChooseLocation" OnMeetings='@(() => Navigate("meetings"))' />
            }
            else if (view == "detail")
            {
                <MeetingReviewView Meeting="selectedMeeting" Location="location" MeetingNumber="@(meetings.IndexOf(selectedMeeting) + 1)"
                                   MeetingCount="meetings.Count" ShowAttendees="showAttendees"
                                   OnToggleAttendees="@(() => showAttendees = !showAttendees)" OnIntent="SetIntent"
                                   OnMove="MoveMeeting" OnPreview="OpenPreview" OnMeetings='@(() => Navigate("meetings"))' />
            }
            else if (view == "preview")
            {
                <ChangePreviewView Preview="preview" MeetingCount="meetings.Count" Location="location" BatchVersion="batchVersion"
                                   OnMeetings='@(() => Navigate("meetings"))' OnReview="ReviewNext" OnApprove="ApproveDemo" />
            }
            else if (view == "results")
            {
                <DemoResultsView HasResults="hasResults" Preview="preview" MeetingCount="meetings.Count" Location="location"
                                 OnMeetings='@(() => Navigate("meetings"))' OnPreview="OpenPreview" OnReset="ResetDemo" />
            }
            else if (view == "help")
            {
                <HelpView OnExplore="@(() => Navigate("meetings"))" OnReset="ResetDemo" />
            }
            <footer class="workspace-footer"><span>Calendar Remediation</span><span>Designed around intent. Always reviewed by you.</span></footer>
        </main>
    </div>
</div>
