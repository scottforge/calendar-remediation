@page "/"
@using Microsoft.AspNetCore.Components.Web
@using CalendarRemediation.Host.Review.Views

<PageTitle>Calendar Remediation · @ViewTitle</PageTitle>
<div class="app-shell" data-workspace="calendar-remediation">
    <aside class="sidebar" aria-label="Workspace navigation">
        <a class="wordmark" href="/">
            <span class="brand-icon" aria-hidden="true">cr</span>
            <span>calendar<small>remediation</small></span>
        </a>
        <p class="workspace-label">WORKSPACE</p>
        <nav>
            @foreach (var item in Navigation)
            {
                <button class="nav-item @(view == item.Key || (view == "detail" && item.Key == "meetings") ? "active" : "")"
                        aria-current="@(view == item.Key || (view == "detail" && item.Key == "meetings") ? "page" : null)" data-nav="@item.Key"
                        @onclick="() => Navigate(item.Key)">
                    <span aria-hidden="true"><AppIcon Name="@item.Icon" /></span>@item.Label
                </button>
            }
            @if (session.HasResults)
            {
                <button class="nav-item @(view == "results" ? "active" : "")" @onclick='() => Navigate("results")'>
                    <span aria-hidden="true"><AppIcon Name="AppIconName.Confirmed" /></span>Simulation results
                </button>
            }
        </nav>
        <div class="sidebar-bottom">
            <div class="sidebar-tip">
                <strong>Your intent. Your decision.</strong>
                <p>Review suggestions. Approve the exact batch.</p>
            </div>
            <div class="profile">
                <span class="avatar">JD</span>
                <div>
                    <strong>Jamie Davis</strong>
                    <small>Workspace profile</small>
                </div>
                <span class="demo-small">PROFILE</span>
            </div>
        </div>
    </aside>
    <div class="main-shell">
        <header class="topbar">
            <div>
                <span>Workspace</span><span class="crumb-divider">/</span><strong>@ViewTitle</strong>
            </div>
            <span class="session-pill"><AppIcon Name="AppIconName.SessionActive" /> Current session</span>
        </header>
        <main id="main-content" class="content" tabindex="-1" @ref="mainContent">
            <div class="demo-banner">
                <span class="banner-icon" aria-hidden="true"><AppIcon Name="AppIconName.Information" /></span>
                <p>
                    <strong>This workspace uses synthetic meetings and preset time offsets, not verified local time rules.</strong>
                    No account, calendar or model is connected here. Approval simulates changes only.
                    Choices reset in a new session. Live, read-only calendar access is separate in <a href="/connect" data-enhance-nav="false">Connect Microsoft 365</a>.
                </p>
            </div>
            <div class="@(string.IsNullOrEmpty(session.Message) ? "sr-only" : "feedback")"
                 role="status" aria-live="polite" aria-atomic="true" data-testid="session-status">
                @session.Message
            </div>
            @if (view == "home")
            {
                <WelcomeView OnStart='() => Navigate("locations")' OnAccount='() => Navigate("account")'
                             OnHelp='() => Navigate("help")' />
            }
            else if (view == "account")
            {
                <AccountView Session="session" OnStart='() => Navigate("locations")'
                             OnHelp='() => Navigate("help")' />
            }
            else if (view == "locations")
            {
                <LocationsView Session="session" OnConfirm="ConfirmLocation" />
            }
            else if (view == "meetings")
            {
                <MeetingWorkspaceView Session="session" Search="@search" ActiveFilter="@activeFilter"
                                      OnSearch="@(value => search = value)" OnFilter="@(value => activeFilter = value)"
                                      OnOpenMeeting="OpenMeeting" OnGuidedReview="StartGuidedReview" OnAssistedReview="StartAssistedReview"
                                      OnLocations='() => Navigate("locations")' OnPreview='() => Navigate("preview")' />
            }
            else if (view == "detail")
            {
                <MeetingReviewView Session="session" Meeting="session.Find(selectedId)!" ShowAttendees="showAttendees"
                                   IsGuided="IsGuidedReview" QueuePosition="GuidedPosition" QueueCount="guidedQueue.Count"
                                   IsLastChoice="IsLastGuidedChoice" OnSaveChoice="SaveGuidedChoice" OnSkipForNow="SkipGuidedChoice"
                                   OnToggleAttendees="() => showAttendees = !showAttendees" OnMove="MoveMeeting"
                                   OnPreview='() => Navigate("preview")' OnMeetings='() => Navigate("meetings")' />
            }
            else if (view == "preview")
            {
                <ChangePreviewView Session="session" OnEdit="OpenMeeting"
                                   OnMeetings='() => Navigate("meetings")' OnApprove="Approve" />
            }
            else if (view == "results")
            {
                <DemoResultsView Session="session" OnMeetings='() => Navigate("meetings")'
                                 OnReset="Reset" />
            }
            else if (view == "help")
            {
                <HelpView OnExplore='() => Navigate("locations")' OnReset="Reset" />
            }
            <footer class="workspace-footer">
                <span>Calendar Remediation</span>
                <span>Your intent. Exact times. Explicit approval.</span>
            </footer>
        </main>
    </div>
</div>
