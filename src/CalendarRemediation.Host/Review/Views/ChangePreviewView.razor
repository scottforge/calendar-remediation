<div class="page-heading">
    <div>
        <p class="eyebrow">FINAL REVIEW · BATCH @Session.BatchVersion</p>
        <h1>Check every selected time</h1>
        <p>@Session.Location.City · @Session.SelectedCount selected · @Session.Preview.Count eligible items in this exact preview</p>
    </div>
    <button class="secondary" @onclick="OnMeetings"><AppIcon Name="AppIconName.Back" /> Edit selections</button>
</div>
<div class="approval-note">
    <strong>Approval is a simulation only.</strong>
    <p>
        Attendee notification impact is <strong>unknown and not simulated</strong>.
        No meetings will be changed or invitations sent.
    </p>
</div>
@if (Session.SelectedCount != Session.EligibleCount)
{
    <section class="panel unresolved">
        <h2>Resolve selected meetings before approval</h2>
        <p>Every selected meeting needs a supported, confirmed local-time or worldwide-time choice. These selections are not in the preview yet:</p>
        <ul>
            @foreach (var meeting in Session.Meetings.Where(m => m.IsSelected && m.Intent is not (DemoIntent.Local or DemoIntent.Instant)))
            {
                <li>
                    <button class="text-button" @onclick="() => OnEdit.InvokeAsync(meeting.Id)">
                        @meeting.Title · choose a time
                    </button>
                </li>
            }
        </ul>
        <p>Open the meeting to confirm a choice, or return to the list and deselect it.</p>
    </section>
}
@if (Session.Preview.Count == 0)
{
    <section class="panel empty-state">
        <h2>No eligible meetings in this preview</h2>
        <p>Select supported meetings and confirm their time choices. Selection alone in guided review does not establish intent. After any change, build a fresh preview.</p>
        <div class="empty-actions">
            <button class="primary" @onclick="OnMeetings">Return to meetings</button>
            <button class="secondary" @onclick="() => Session.BuildPreview()">Build current preview</button>
        </div>
    </section>
}
else
{
    <div class="preview-items">
        @foreach (var item in Session.Preview)
        {
            var meeting = Session.Find(item.Id)!;
            <article class="panel preview-item" data-preview-item="@item.Id" @key="item.Id">
                <div class="item-heading">
                    <div>
                        <p class="item-id">@item.Duration minutes per occurrence</p>
                        <h2>@item.Title</h2>
                    </div>
                    <span class="status-badge @(item.Before == item.After ? "neutral" : "blue")">
                        @(item.Before == item.After ? "No stored time change" : "Proposed time update")
                    </span>
                </div>
                <p class="scope">@meeting.RecurrenceScope</p>
                <p class="choice">
                    @(meeting.HasManualDecision ? "Your confirmed choice" : "Applied suggestion · approval confirms this choice"):
                    @DemoDisplay.StatusLabel(meeting)
                </p>
                @foreach (var occurrence in item.Occurrences)
                {
                    <div class="occurrence">
                        <div class="time-side">
                            <h3>Source schedule</h3>
                            <p class="local-time">@LocalRange(occurrence.BeforeStart, occurrence.BeforeEnd, Session.Location.SourceOffset)</p>
                            <p>@Session.Location.City · UTC@DemoDisplay.Offset(Session.Location.SourceOffset)</p>
                            <p class="utc-time">@UtcRange(occurrence.BeforeStart, occurrence.BeforeEnd)</p>
                        </div>
                        <span class="time-arrow" aria-hidden="true"><AppIcon Name="AppIconName.Next" /></span>
                        <div class="time-side proposed">
                            <h3>Proposed schedule</h3>
                            <p class="local-time">@LocalRange(occurrence.AfterStart, occurrence.AfterEnd, Session.Location.TargetOffset)</p>
                            <p>@Session.Location.City · UTC@DemoDisplay.Offset(Session.Location.TargetOffset)</p>
                            <p class="utc-time">@UtcRange(occurrence.AfterStart, occurrence.AfterEnd)</p>
                        </div>
                    </div>
                }
                <p class="notification">
                    <strong>Attendee notification: unknown.</strong>
                    @meeting.Attendees.Length attendees. Delivery and invitation effects are not simulated.
                </p>
                <div class="item-actions">
                    <button class="secondary" @onclick="() => OnEdit.InvokeAsync(item.Id)">Edit time choice</button>
                    <button class="text-button" @onclick="() => Remove(item.Id)">Remove from batch</button>
                </div>
            </article>
        }
    </div>
    <section class="panel approval">
        <h2>@(Session.HasResults ? "This exact batch was already simulated" : "Approve this exact batch for simulation?")</h2>
        <p>
            Approval covers only the @Session.Preview.Count item(s) and all occurrence times shown above, including any no-change decisions.
            Duration is unchanged. The simulation records no durable approval or history.
        </p>
        <button class="primary" disabled="@(!Session.CanApprove)" @onclick="OnApprove" data-testid="approve-simulate">
            Approve &amp; simulate @Session.Preview.Count item(s)
        </button>
        @if (Session.HasResults)
        {
            <p>Your existing results are preserved in Simulation results. This unchanged batch cannot be approved again.</p>
        }
        else if (!Session.CanApprove)
        {
            <p>Approval is unavailable until every selected meeting has an eligible confirmed choice and a current preview. Return to meetings to resolve the selection.</p>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public DemoReviewSession Session { get; set; } = null!;
    [Parameter] public EventCallback<string> OnEdit { get; set; }
    [Parameter] public EventCallback OnMeetings { get; set; }
    [Parameter] public EventCallback OnApprove { get; set; }

    private void Remove(string id)
    {
        Session.SetSelected(id, false);
        Session.BuildPreview();
    }

    private static string LocalRange(DateTimeOffset start, DateTimeOffset end, int offset)
    {
        var localStart = start.ToOffset(TimeSpan.FromHours(offset)).ToString("MMM d, yyyy · h:mm tt", DemoDisplay.Culture);
        var localEnd = end.ToOffset(TimeSpan.FromHours(offset)).ToString("MMM d, yyyy · h:mm tt", DemoDisplay.Culture);
        return $"{localStart} → {localEnd}";
    }

    private static string UtcRange(DateTimeOffset start, DateTimeOffset end)
    {
        var utcStart = start.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'", DemoDisplay.Culture);
        var utcEnd = end.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'", DemoDisplay.Culture);
        return $"{utcStart} → {utcEnd}";
    }
}
