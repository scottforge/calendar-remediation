<div class="page-heading">
    <div>
        <p class="eyebrow">SIMULATION RESULTS</p>
        <h1>@(Session.HasResults ? "Your batch was simulated" : "No current simulation")</h1>
        <p>No calendar changes, attendee messages or provider requests were made.</p>
    </div>
</div>
@if (Session.HasResults)
{
    <div class="results-summary panel">
    <span class="result-mark" aria-hidden="true"><AppIcon Name="AppIconName.Confirmed" /></span>
        <div>
            <h2>@Session.Preview.Count item(s) simulated</h2>
            <p>These results reflect the exact approved batch. They do not verify any provider outcome.</p>
        </div>
    </div>
    <section class="panel result-list" aria-label="Per-item simulation results">
        @foreach (var item in Session.Preview)
        {
            <article class="result-item" data-result-item="@item.Id">
                <div>
                    <h2>@item.Title</h2>
                    <p>@Session.Find(item.Id)!.RecurrenceScope</p>
                    <p>
                        @(item.Before == item.After
                            ? "No-change decision simulated. The stored time stays the same."
                            : "Time-update decision simulated. No stored meeting was actually updated.")
                    </p>
                    <p>
                        First occurrence: @item.After.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'", DemoDisplay.Culture)–@item.After.AddMinutes(item.Duration).ToUniversalTime().ToString("HH:mm 'UTC'", DemoDisplay.Culture) ·
                        @item.Duration minutes unchanged.
                    </p>
                    <p>Attendee notification: <strong>unknown, not simulated</strong>.</p>
                </div>
                <span class="status-badge blue">Simulation only</span>
            </article>
        }
    </section>
}
else
{
    <section class="panel empty-state">
        <h2>Build and approve a batch first</h2>
        <p>Changing selections, choices, location or review suggestions clears earlier simulation results.</p>
    </section>
}
<section class="session-note">
    <h2>Only in this session</h2>
    <p>
        There is no permanent history, retry or revert operation. A new session or reset clears your work.
        Changing any review decision clears these results and requires a new preview and approval.
    </p>
</section>
<div class="detail-actions">
    <button class="primary" @onclick="OnMeetings">Back to meetings</button>
    <button class="secondary" @onclick="OnReset">Reset workspace</button>
</div>

@code {
    [Parameter, EditorRequired] public DemoReviewSession Session { get; set; } = null!;
    [Parameter] public EventCallback OnMeetings { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
}
