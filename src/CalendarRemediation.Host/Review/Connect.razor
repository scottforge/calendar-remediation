@page "/"
@page "/connect"
@layout CalendarRemediation.Host.Review.Connect.ConnectionLayout
@using CalendarRemediation.Host.Authentication
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Live calendar preview · Calendar Remediation</PageTitle>
<a class="skip-link" href="#connection-content">Skip to connection</a>
<div class="connection-shell">
    <header class="connection-header">
        <a href="/demo" data-enhance-nav="false">Synthetic demo workspace</a>
        <span class="status-badge neutral">LIVE · READ ONLY</span>
    </header>
    <main id="connection-content" tabindex="-1">
        <div class="page-heading">
            <div>
                <p class="eyebrow">LOCAL CONNECTION</p>
                <h1>Live calendar preview</h1>
                <p>Connect Microsoft 365, discover organizer meetings, then explore an intended meeting time.</p>
            </div>
        </div>
        <div class="connection-notice">
            <strong>This is live, read-only data.</strong>
            Sign-in requests User.Read and Calendars.Read. No meetings are changed, no invitations are sent,
            and no meeting data is sent to a model. Synthetic demo choices do not apply here.
        </div>
        <p role="status" aria-live="polite" aria-atomic="true">@StatusText</p>
        @if (_refreshError is not null)
        {
            <div class="connection-error" role="alert">
                <p>@_refreshError</p>
                <a href="/connect" data-enhance-nav="false">Reload connection status</a>
            </div>
        }
        @if (_state is { } state)
        {
            @if (state.Phase != ConnectionPhase.Disabled && state.Problem is { } problem)
            {
                <div class="connection-error" role="alert"><strong>@problem.Code</strong>: @problem.Message</div>
            }
            @if (state.Phase == ConnectionPhase.Disabled)
            {
                <section class="panel connection-card" aria-labelledby="setup-heading">
                    <h2 id="setup-heading">1. Account</h2>
                    <p>Sign-in is unavailable with the current configuration. See Developer configuration for setup details and the reported problem.</p>
                    <button type="button" class="primary" disabled>Sign in with Microsoft</button>
                    <details class="connection-setup">
                        <summary>Developer configuration</summary>
                        <p>Use an app registration that supports work/school and personal Microsoft accounts, with <code>api.requestedAccessTokenVersion</code> set to <code>2</code>. Add the <code>http://localhost</code> desktop callback. Set <code>LocalConnection__TenantId</code> to your organization tenant GUID and <code>LocalConnection__ClientId</code> to the app registration GUID, then restart the app. No client secret is needed.</p>
                        <p>The tenant GUID pins work/school sign-in to your organization; personal Microsoft account sign-in, such as Outlook.com, is still allowed.</p>
                        <p>Open the localhost address printed at startup. Windows protects the persistent account cache. Other platforms keep tokens in memory, so restarting requires sign-in again.</p>
                        @if (state.Problem is { } setupProblem)
                        {
                            <p>@setupProblem.Code: @setupProblem.Message</p>
                        }
                        <a href="/connect" data-enhance-nav="false">Check configuration again</a>
                    </details>
                </section>
            }
            else if (string.IsNullOrEmpty(state.Version))
            {
                <section class="panel connection-card" aria-labelledby="bootstrap-heading">
                    <h2 id="bootstrap-heading">1. Account</h2>
                    <p>Sign in with the Microsoft 365 or Outlook.com account whose calendar you want to preview.</p>
                    <form method="post" action="/connection/signin" data-enhance="false">
                        <AntiforgeryToken />
                        <input type="hidden" name="version" value="@state.Version" />
                        <button type="submit" class="primary">Sign in with Microsoft</button>
                    </form>
                </section>
            }
            else
            {
                <section class="panel connection-card" aria-labelledby="identity-heading">
                    <h2 id="identity-heading">1. Account</h2>
                    @if (state.Phase == ConnectionPhase.SigningIn)
                    {
                        <p>Finish signing in with Microsoft in this tab. You will return here automatically.</p>
                        <p>Checking your account and calendar may take a moment.</p>
                    }
                    else if (state.Phase == ConnectionPhase.AwaitingCompletion)
                    {
                        <p>Finishing sign-in for <strong>@state.Mailbox?.Address</strong>…</p>
                        <p>@(_completionFailed ? "Automatic sign-in could not continue. Use the button below to retry." : "This page will continue automatically. If it does not, use Continue sign-in below.")</p>
                        <form @ref="_completionForm" method="post" action="/connection/complete" data-enhance="false">
                            <AntiforgeryToken />
                            <input type="hidden" name="version" value="@state.Version" />
                            <button type="submit" class="secondary">@(_completionFailed ? "Retry sign-in" : "Continue sign-in")</button>
                        </form>
                    }
                    else if (state.Mailbox is { } mailbox)
                    {
                        <p><strong>@mailbox.DisplayName</strong><br />@mailbox.Address</p>
                        <p>Verified mailbox and default calendar. Access is read only.</p>
                    }
                    else
                    {
                        <p>Sign in with the account whose calendar you want to read.</p>
                        @if (state.CachedAccount is { } cached)
                        {
                            <details>
                                <summary>Use a previously signed-in account</summary>
                                <p>Previously used account: <strong>@cached</strong>. Continue to verify it again.</p>
                                <form method="post" action="/connection/start" data-enhance="false">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="version" value="@state.Version" />
                                    <input type="hidden" name="mode" value="continue" />
                                    <button type="submit" class="secondary">Continue with this account</button>
                                </form>
                            </details>
                        }
                    }
                    <div class="connection-actions">
                        @if (state.Phase is ConnectionPhase.SignedOut or ConnectionPhase.Failed)
                        {
                            <form method="post" action="/connection/signin" data-enhance="false">
                                <AntiforgeryToken />
                                <input type="hidden" name="version" value="@state.Version" />
                                <button type="submit" class="primary">Sign in with Microsoft</button>
                            </form>
                        }
                        @if (state.Phase is ConnectionPhase.SigningIn or ConnectionPhase.AwaitingCompletion or ConnectionPhase.Discovering)
                        {
                            <form method="post" action="/connection/cancel" data-enhance="false">
                                <AntiforgeryToken />
                                <input type="hidden" name="version" value="@state.Version" />
                                <button type="submit" class="secondary">Cancel @(state.Phase == ConnectionPhase.Discovering ? "calendar read" : "sign-in")</button>
                            </form>
                        }
                        @if (state.Phase is ConnectionPhase.SignedOut or ConnectionPhase.Failed or ConnectionPhase.SigningIn or ConnectionPhase.AwaitingCompletion || state.Mailbox is not null)
                        {
                            <form method="post" action="/connection/signout" data-enhance="false">
                                <AntiforgeryToken />
                                <input type="hidden" name="version" value="@state.Version" />
                                <button type="submit" class="secondary">Disconnect and clear app account cache</button>
                            </form>
                        }
                    </div>
                    <p class="connection-hint">To switch accounts, disconnect, then sign in again. Disconnect clears this app's account cache, not your Microsoft browser session.</p>
                </section>
                @if (state.Mailbox is not null && state.Phase is ConnectionPhase.Connected or ConnectionPhase.Discovering or ConnectionPhase.Failed)
                {
                    <section class="panel connection-card" aria-labelledby="location-heading">
                        <h2 id="location-heading">2. Location</h2>
                        <p>Confirm the community and time zone to use for previews. Device suggestion: <strong>@state.SuggestedTimeZoneId</strong>. This does not choose a meeting time for you.</p>
                        @if (state.Location is { } location)
                        {
                            <p>Confirmed: <strong>@location.Community, @location.Province · @location.TimeZoneId</strong></p>
                        }
                        <form method="post" action="/connection/location" data-enhance="false">
                            <AntiforgeryToken />
                            <input type="hidden" name="version" value="@state.Version" />
                            <div class="location-fields">
                                <div>
                                    <label for="connection-province">Province</label>
                                    <select id="connection-province" name="province" required value="@_province" @onchange="ChangeProvince">
                                        <option value="">Choose province</option>
                                        @foreach (var province in LocalConnectionService.LocationZones.Keys)
                                        {
                                            <option value="@province">@ProvinceName(province)</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label for="connection-community">City or community</label>
                                    <input id="connection-community" name="community" required maxlength="100" @bind="_community" autocomplete="address-level2" />
                                </div>
                                <div>
                                    <label for="connection-zone">Time zone (explicit choice)</label>
                                    <select id="connection-zone" name="timeZoneId" required @bind="_timeZoneId" aria-describedby="zone-help">
                                        <option value="">Choose time zone</option>
                                        @foreach (var zone in AvailableZones)
                                        {
                                            <option value="@zone">@zone</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <p id="zone-help" class="connection-hint">Select the zone for your community, not just the province's largest city. Changing location clears previous discovery and cancels any active read.</p>
                            <button type="submit" class="secondary">Confirm location and time zone</button>
                        </form>
                    </section>
                    <section class="panel connection-card" aria-labelledby="discovery-heading">
                        <h2 id="discovery-heading">3. Discover meetings</h2>
                        <p>Read the next 90 days from your default calendar and list meetings you organize.</p>
                        <form method="post" action="/connection/discover" data-enhance="false">
                            <AntiforgeryToken />
                            <input type="hidden" name="version" value="@state.Version" />
                            <button type="submit" class="primary" disabled="@(state.Location is null || state.Phase == ConnectionPhase.Discovering)">Discover next 90 days</button>
                        </form>
                        @if (state.Location is null)
                        {
                            <p>Confirm your community and time zone above before discovery.</p>
                        }
                        @if (state.Phase == ConnectionPhase.Discovering)
                        {
                            <p>Reading your calendar… You can cancel above.</p>
                        }
                        @if (state.Discovery is { } discovery)
                        {
                            <h3>@(discovery.Complete ? "Discovery complete within the requested scope" : "Partial discovery · results are incomplete")</h3>
                            <p>@FormatUtc(discovery.Start) through @FormatUtc(discovery.End).</p>
                            <p>@discovery.ObservedEvents events observed · @discovery.OrganizerMeetings.Length organizer meetings returned.</p>
                            <p class="connection-hint">Read limits: 500 observed events, 10 pages, 500 detail reads and two minutes. All timestamps below are UTC, not inferred meeting intent.</p>
                            @if (!discovery.Holds.IsDefaultOrEmpty)
                            {
                                <h3>Holds and limitations</h3>
                                <ul>
                                    @foreach (var hold in discovery.Holds)
                                    {
                                        <li>@hold</li>
                                    }
                                </ul>
                            }
                            @if (discovery.OrganizerMeetings.IsEmpty)
                            {
                                <p>No organizer meetings were returned in this read.@(!discovery.Complete ? " This does not establish that your calendar has none." : "")</p>
                            }
                            else
                            {
                                <p id="meeting-scroll-help">All returned organizer meetings are listed below. Scroll within the table to review them.</p>
                                <div class="meeting-scroll" role="region" aria-label="Discovered organizer meetings" aria-describedby="meeting-scroll-help" tabindex="0">
                                    <table>
                                        <caption>Live organizer meeting metadata · times in UTC</caption>
                                        <thead><tr><th scope="col">Start (UTC)</th><th scope="col">End (UTC)</th><th scope="col">Organizer</th><th scope="col">Kind</th><th scope="col">Attendees</th></tr></thead>
                                        <tbody>
                                            @foreach (var meeting in discovery.OrganizerMeetings)
                                            {
                                                <tr><td>@FormatUtc(meeting.Start)</td><td>@FormatUtc(meeting.End)</td><td>@(meeting.Organizer ?? "Not supplied")</td><td>@meeting.Kind</td><td>@meeting.AttendeeCount</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (state.Location is { } previewLocation && !discovery.OrganizerMeetings.IsEmpty)
                            {
                                <section class="meeting-preview" aria-labelledby="preview-heading">
                                    <h3 id="preview-heading">4. Preview a meeting time</h3>
                                    <p>Choose a meeting and the time you intend. This read-only calculation uses this computer's time-zone rules and does not verify special policy or Microsoft 365 rule adoption.</p>
                                    <p id="preview-snapshot-help" class="connection-hint">Source times are from your last discovery. Discover again for newer data. Recurring, all-day, or other unsupported meetings may not produce a preview.</p>
                                    <p>Confirmed location: <strong>@previewLocation.Community, @previewLocation.Province</strong><br />Preview time zone: <strong>@previewLocation.TimeZoneId</strong></p>
                                    <form method="post" action="/connection/preview" data-enhance="false">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="version" value="@state.Version" />
                                        <input type="hidden" name="timeZoneId" value="@previewLocation.TimeZoneId" />
                                        <fieldset class="preview-fields" disabled="@(state.Phase != ConnectionPhase.Connected || !discovery.Complete)">
                                            <legend>Choose the meeting and your intended time</legend>
                                            <div>
                                                <label for="preview-event">Meeting (source local start, UTC and ID)</label>
                                                <select id="preview-event" name="eventId" required aria-describedby="preview-snapshot-help">
                                                    <option value="">Choose a meeting</option>
                                                    @foreach (var meeting in discovery.OrganizerMeetings)
                                                    {
                                                        <option value="@meeting.Id">@FormatLocal(meeting.Start, previewLocation.TimeZoneId) · @FormatUtc(meeting.Start) · @meeting.Kind · ID @meeting.Id</option>
                                                    }
                                                </select>
                                            </div>
                                            <div>
                                                <label for="preview-mode">What should the preview preserve?</label>
                                                <select id="preview-mode" name="mode" required @bind="_previewMode" aria-describedby="preview-intent-help">
                                                    <option value="">Choose preservation intent</option>
                                                    <option value="local">Use my intended local date and time</option>
                                                    <option value="instant">Keep the same absolute instant (UTC time)</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label for="preview-local-start">Intended local start in @previewLocation.TimeZoneId</label>
                                                <input id="preview-local-start" name="localStart" type="datetime-local" step="60" required="@(_previewMode == "local")" disabled="@(_previewMode != "local")" aria-describedby="preview-intent-help" />
                                            </div>
                                            <p id="preview-intent-help" class="connection-hint">Enter your intended local wall-clock date and time in the confirmed zone, or keep the same absolute instant (UTC time) without a date input. We do not guess the original meeting intent from its timestamps or your device.</p>
                                            <button type="submit" class="primary" disabled="@(state.Phase != ConnectionPhase.Connected || !discovery.Complete)">Calculate read-only preview</button>
                                        </fieldset>
                                    </form>
                                    @if (!discovery.Complete)
                                    {
                                        <p>Complete discovery is required before calculating a preview.</p>
                                    }
                                    @if (state.Preview is { } preview)
                                    {
                                        <section class="preview-result" aria-labelledby="preview-result-heading">
                                            <h3 id="preview-result-heading">Last submitted preview: @preview.Disposition</h3>
                                            <p><strong>Meeting with source times @FormatLocal(preview.CurrentStart, preview.TimeZoneId) to @FormatLocal(preview.CurrentEnd, preview.TimeZoneId)</strong></p>
                                            <p><strong>Start change: @PreviewChange(preview.CurrentStart, preview.ProposedStart)</strong></p>
                                            <p>@preview.Reason</p>
                                            <p class="connection-hint">Changing the form does not recalculate this result. Submit again to preview another choice.</p>
                                            <p>Times shown in <strong>@preview.TimeZoneId</strong> and UTC. A missing proposed time does not mean no change is needed.</p>
                                            <dl class="preview-times">
                                                <div><dt>Source start</dt><dd>@FormatLocal(preview.CurrentStart, preview.TimeZoneId)<br /><span>@FormatUtc(preview.CurrentStart)</span></dd></div>
                                                <div><dt>Source end</dt><dd>@FormatLocal(preview.CurrentEnd, preview.TimeZoneId)<br /><span>@FormatUtc(preview.CurrentEnd)</span></dd></div>
                                                <div><dt>Proposed start</dt><dd>@FormatLocal(preview.ProposedStart, preview.TimeZoneId)<br /><span>@FormatUtc(preview.ProposedStart)</span></dd></div>
                                                <div><dt>Proposed end</dt><dd>@FormatLocal(preview.ProposedEnd, preview.TimeZoneId)<br /><span>@FormatUtc(preview.ProposedEnd)</span></dd></div>
                                            </dl>
                                            <p class="connection-hint">Read-only calculation only. No calendar changes or invitations have been sent.</p>
                                        </section>
                                    }
                                </section>
                            }
                        }
                    </section>
                }
            }
        }
        <footer class="connection-footer">
            <p>Status continues to refresh every 15 seconds when idle. If this page loses its session, displayed account and meeting data are cleared.</p>
            <p>Actions reload this page to refresh the authenticated session. If an action opens a JSON error or blank error page, return to <a href="/connect" data-enhance-nav="false">/connect</a> to load current status before retrying. Do not resubmit an old form.</p>
        </footer>
    </main>
</div>
