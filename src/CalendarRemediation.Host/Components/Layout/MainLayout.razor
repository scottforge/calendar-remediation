@inherits LayoutComponentBase
@inject NavigationManager Navigation

<a class="skip-link" href="#main-content">Skip to content</a>

@if (Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Length == 0)
{
    @Body
}
else
{
    <header class="route-return"><a href="/demo"><AppIcon Name="AppIconName.Back" /> Calendar Remediation workspace</a><span>Local workspace · No calendar connection</span></header>
    <main id="main-content" class="route-content" tabindex="-1">
        @Body
    </main>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" aria-label="Dismiss"><AppIcon Name="AppIconName.Dismiss" /></span>
</div>
